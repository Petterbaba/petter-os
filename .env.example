# Mal for .env.local – kopier og fyll inn. Ekte verdier sjekkes aldri inn.
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Kun for scripts/backup.sh (pg_dump via session pooler) – aldri i Next-appen.
# NB: host-prefikset (aws-0/aws-1) varierer – kopier alltid strengen fra
# dashboardets Connect-dialog (Session pooler) i stedet for å skrive den selv.
SUPABASE_DB_URL=postgresql://postgres.<prosjekt-ref>:<db-passord>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Oda-kurven (/mat): nøkkel for den krypterte tilkoblings-cookien. Min. 32
# tegn – lag én med `openssl rand -base64 32`. Bytter du nøkkelen, må
# nettleserne koble til Oda på nytt (ingenting lagres i databasen).
ODA_COOKIE_SECRET=<tilfeldig-streng-min-32-tegn>
